# RevenueCat Public SDK API Keys (Obtain from https://app.revenuecat.com)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_actual_revenuecat_apple_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_actual_revenuecat_google_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro_access

# OneSignal Push App ID (Obtain from https://onesignal.com)
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_actual_onesignal_app_id
